# Copy this file to .env and fill in real local values. Never commit .env.

# Local MySQL/MariaDB connection.
# allowPublicKeyRetrieval=true is needed for MySQL 8+ accounts using
# caching_sha2_password (the default) over a non-SSL local connection —
# without it, connections can fail with an "RSA public key is not
# available client side" error.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/accounting_tool?allowPublicKeyRetrieval=true"

# App
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (accounting-web dev server by default).
# In production: the exact web origin — scheme + host, NO trailing slash, never "*"
# (the app refuses to start with "*"), e.g. https://exin-finance.sam-trek.com
CORS_ORIGIN="http://localhost:5173"
# Set when deployed behind a reverse proxy / load balancer (number of proxy hops,
# e.g. 1) so rate limiting sees real client IPs. Leave unset when not behind one —
# otherwise clients can spoof X-Forwarded-For and dodge rate limits.
# In production behind Coolify's Traefik there is exactly one hop: TRUST_PROXY=1
# TRUST_PROXY=1

# Auth (Stage 1 — email/password)
JWT_SECRET="change-me-to-a-random-string-at-least-32-characters-long"
JWT_EXPIRES_IN="1d"

# Encrypts sensitive Business fields (bank account/routing number, SWIFT code)
# at rest. Must be a base64-encoded 32-byte key — generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing/changing this key makes previously-encrypted bank details unreadable.
ENCRYPTION_KEY="change-me-generate-a-real-32-byte-base64-key"

# Invoice PDFs (Stage 1 — local disk storage)
INVOICE_STORAGE_DIR="./storage/invoices"
# Uploaded invoice/receipt files attached to ledger entries (Stage 1 — local disk storage)
RECEIPT_STORAGE_DIR="./storage/receipts"
# Production (Docker): put both on a persistent volume mounted at /data. The
# absolute path of every file is stored in the database, so set these once and
# never change them — moving the directory orphans every existing file.
# The Docker image already sets these two; only override them if you must.
# INVOICE_STORAGE_DIR=/data/invoices
# RECEIPT_STORAGE_DIR=/data/receipts

# Only needed if Puppeteer's Chromium was installed to a non-default cache dir.
# PUPPETEER_CACHE_DIR="D:\\puppeteer-cache"
# Use a system Chromium instead of Puppeteer's own download (Puppeteer reads this
# itself). The Docker image sets it to /usr/bin/chromium (Debian's package),
# because Puppeteer has no Chrome download for Linux ARM64.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# Set to exactly "true" ONLY inside a container: Chromium's sandbox cannot start
# under Docker's default seccomp profile, so PDF rendering needs it off. The
# Docker image sets it. Leave unset on a normal machine — there the sandbox is a
# real defence.
# PUPPETEER_NO_SANDBOX=true

# PRODUCTION SECRETS: generate JWT_SECRET and ENCRYPTION_KEY freshly for every
# environment (commands above). Never copy the values from your local .env, never
# commit them, and keep a copy of ENCRYPTION_KEY in a password manager — losing it
# makes the encrypted bank details unreadable forever.

