# Copy this file to .env and fill in real local values. Never commit .env.

# Local MySQL/MariaDB connection.
# allowPublicKeyRetrieval=true is needed for MySQL 8+ accounts using
# caching_sha2_password (the default) over a non-SSL local connection —
# without it, connections can fail with an "RSA public key is not
# available client side" error.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/accounting_tool?allowPublicKeyRetrieval=true"

# App
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (accounting-web dev server by default)
CORS_ORIGIN="http://localhost:5173"

# Auth (Stage 1 — email/password)
JWT_SECRET="change-me"
JWT_EXPIRES_IN="1d"

# Invoice PDFs (Stage 1 — local disk storage)
INVOICE_STORAGE_DIR="./storage/invoices"
# Uploaded invoice/receipt files attached to ledger entries (Stage 1 — local disk storage)
RECEIPT_STORAGE_DIR="./storage/receipts"
# Only needed if Puppeteer's Chromium was installed to a non-default cache dir.
# PUPPETEER_CACHE_DIR="D:\\puppeteer-cache"
