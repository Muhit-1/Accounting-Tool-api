// Prisma schema for the Multi-Business Accounting Tool
// See ../../Assest and doc/Accounting-Tool-Project-Plan.docx for the full plan.
// Account data is modeled as double-entry (Transaction -> Line[]) from day one,
// even though Phase 1's UI only shows a simple money-in/money-out list.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum LineDirection {
  DEBIT
  CREDIT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

// An order's life: new -> confirmed -> shipped -> delivered, with cancel/return
// as the ways out. Only DELIVERED orders are money; see order/order-status.ts.
enum OrderStatus {
  NEW
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

// What a delivered order does to its fund account.
enum OrderPostingRule {
  MONEY_IN
  DEDUCT_FROM_FUND
}

enum StorageProvider {
  LOCAL
  DRIVE
}

enum AccessScope {
  BUSINESS
  TABLE
}

enum AccessPermission {
  VIEW
  EDIT
}

// A person who can log in. Login is Google only (Stage 2); email + password
// still exists behind AUTH_PASSWORD_ENABLED for local dev and tests.
model User {
  id                    String   @id @default(cuid())
  email                 String   @unique
  passwordHash          String? // bcrypt; null for Google-created accounts
  googleSub             String?  @unique // Google's stable account id (the ID token's `sub`)
  // Google refresh token, AES-256-GCM encrypted via EncryptionService (never plaintext).
  googleRefreshTokenEnc String?  @db.Text
  name                  String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  businesses   Business[]    @relation("BusinessOwner")
  accessGrants AccessGrant[] @relation("Grantee")

  @@map("users")
}

// One of the client's companies (SAMTrek, Vaaii, Shopnojhuri, ...).
// Also carries the sender profile shown on generated invoices.
model Business {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation("BusinessOwner", fields: [ownerId], references: [id])

  name     String
  currency String @default("BDT")

  // Invoice sender profile (Section 4 of the invoice template mapping).
  logoUrl           String? @db.Text // may hold a base64 data URI for an uploaded logo
  address           String? @db.Text
  contactEmail      String?
  website           String?
  bankAccountName   String?
  bankAccountNumber String?
  bankRoutingNumber String?
  bankSwiftCode     String?
  bankBranch        String?
  defaultTerms      String? @db.Text // default Terms & Conditions text, overridable per invoice
  // Letters in front of order numbers ("SJ" -> SJ-0001). Null = initials of the name.
  orderPrefix       String? @db.VarChar(10)

  driveFolderId String? // set once Stage 2 (Google Drive) is live

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories   Category[]
  transactions Transaction[]
  accounts     Account[]
  clients      Client[]
  invoices     Invoice[]
  documents    Document[]
  accessGrants AccessGrant[]
  orders       Order[]

  @@map("businesses")
}

// One of a venture's books — a venture can keep several (e.g. "Cash",
// "Bank") and each has its own independent set of transactions.
model Account {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  orders       Order[]

  @@map("accounts")
}

// A saved bill-to party for a business, reused across invoices.
model Client {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name    String
  address String  @db.Text
  email   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@map("clients")
}

// Income/expense grouping, editable per business.
model Category {
  id         String       @id @default(cuid())
  businessId String
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  type       CategoryType
  // Optional heading the category is listed under (e.g. "Overhead"); entries
  // without one show under "Other". Plain text, not a separate table.
  groupName  String?      @db.VarChar(60)

  createdAt DateTime @default(now())

  lines Line[]

  @@map("categories")
}

// An account entry. Phase 1's UI shows this as a single money-in/money-out row;
// underneath it is a debit/credit pair of Lines, so full double-entry views
// (Phase 3) don't require a schema rewrite.
model Transaction {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date         DateTime
  memo         String?
  // Who the money moved with — the vendor on a bill you paid (EXPENSE) or
  // the client who paid you (INCOME). Free text, usually prefilled from a
  // scanned/uploaded invoice (see InvoiceScanService.extractCounterparty).
  counterparty String?

  // The source document (invoice/receipt) the user uploaded when creating
  // this entry via "Upload invoice" — kept so they can open it again later.
  // All three are set together or not at all.
  receiptFileReference String? // path on disk (Stage 1 local storage)
  receiptFileName      String? // original filename, for a friendly download name
  receiptMimeType      String?

  // Link to an outside proof (payment screenshot, receipt). https only —
  // validated in the DTO; the web opens it with rel="noopener noreferrer".
  proofUrl String? @db.Text

  // How the amount was entered. Null = FIXED (every entry made before this
  // existed). For the other types the server recomputes the amount from
  // `amountInputs` (see common/calc.ts) and saves that, never the client's.
  amountType   String? @db.VarChar(20)
  amountInputs Json? // number[], the named boxes in order

  // Set when this entry was posted by a delivered order. It is owned by the
  // order: edited or removed only by changing the order (see OrderService).
  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  lines Line[]

  @@map("transactions")
}

model Line {
  id            String        @id @default(cuid())
  transactionId String
  transaction   Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category?     @relation(fields: [categoryId], references: [id])
  amount        Decimal       @db.Decimal(14, 2)
  direction     LineDirection

  @@map("lines")
}

// A customer order. `total` is always worked out by the server
// (subtotal + delivery - discount). A DELIVERED order owns one Transaction in
// its fund account, created/updated/removed with the order's status.
model Order {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  accountId  String // the fund account a delivered order posts into
  account    Account  @relation(fields: [accountId], references: [id])

  number Int // highest + 1 per business; shown as e.g. SJ-0001

  orderDate       DateTime
  customerName    String           @db.VarChar(120)
  customerPhone   String?          @db.VarChar(30)
  customerEmail   String?          @db.VarChar(254)
  customerAddress String?          @db.Text
  items           String?          @db.Text // free text, e.g. "Wooden puzzle x 1"
  subtotal        Decimal          @db.Decimal(14, 2)
  deliveryCharge  Decimal          @default(0) @db.Decimal(14, 2)
  discount        Decimal          @default(0) @db.Decimal(14, 2)
  total           Decimal          @db.Decimal(14, 2)
  paymentMethod   String?          @db.VarChar(60)
  status          OrderStatus      @default(NEW)
  postingRule     OrderPostingRule @default(MONEY_IN)
  deliveryDate    DateTime?
  notes           String?          @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transaction Transaction?

  @@unique([businessId, number])
  @@map("orders")
}

// A generated invoice.
model Invoice {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])

  number    String // sequential per business, e.g. shown as "#20260812"
  issueDate DateTime
  terms     String // e.g. "Due end of the month"
  dueDate   DateTime

  subTotal Decimal       @db.Decimal(14, 2)
  total    Decimal       @db.Decimal(14, 2)
  status   InvoiceStatus @default(DRAFT)

  fileReference String? // path (Stage 1 local disk) or Drive file id (Stage 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items InvoiceItem[]

  @@unique([businessId, number])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position    Int
  description String  @db.Text
  quantity    Decimal @db.Decimal(10, 2)
  rate        Decimal @db.Decimal(14, 2)
  amount      Decimal @db.Decimal(14, 2)

  @@map("invoice_items")
}

// Any stored file (invoice PDFs, receipts, etc.).
model Document {
  id              String          @id @default(cuid())
  businessId      String
  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type            String
  storageProvider StorageProvider @default(LOCAL)
  fileReference   String

  createdAt DateTime @default(now())

  @@map("documents")
}

// A sharing permission: the owner grants another user time-limited,
// scoped access to a whole business or a single table.
model AccessGrant {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  granteeId  String
  grantee    User     @relation("Grantee", fields: [granteeId], references: [id])

  scope      AccessScope
  tableName  String? // only set when scope = TABLE
  permission AccessPermission

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@map("access_grants")
}
